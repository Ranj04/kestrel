# ALL OPTIONAL. The app must be fully demoable with every one of these unset.
# The LLM only parses free-text orders and maps brand names to generics; both
# have deterministic fallbacks. It never writes clinical or policy text.

# Preferred at an AWS Builder Loft:
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=

# Fallbacks, whichever you already have:
OPENAI_API_KEY=
# Tried only if OPENAI_API_KEY fails (429/403/network). The credential that
# actually served a call is recorded in the ledger as model.params.credential.
OPENAI_API_KEY_FALLBACK=

ANTHROPIC_API_KEY=
XAI_API_KEY=
